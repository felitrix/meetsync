{
  "name": "meetsync",
  "version": "0.5.0",
  "private": true,
  "description": "Captura as legendas do Google Meet, exibe em chat e exporta .txt/.json; correção, resumo e perguntas com IA via Ollama.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "zip": "node scripts/zip.mjs",
    "package": "npm run build && npm run zip",
    "publish:store": "node scripts/publish-store.mjs",
    "relay:key": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/credential-helper.ps1 -Set",
    "relay": "node companion/nvidia-relay.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.6.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.19.21",
    "chrome-webstore-upload-cli": "^4.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
